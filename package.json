{
  "name": "screenplay-kit",
  "version": "0.2.4",
  "description": "Scripted, narrated product videos recorded from the app itself: a Playwright driver with a drawn cursor, captions and title cards, an ElevenLabs voice kept on the picture, and the playbook of what was learned making them.",
  "license": "MIT",
  "repository": "github:magicmiguelx/screenplay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./three": "./dist/three.js",
    "./voice": "./dist/voice.js"
  },
  "bin": {
    "screenplay-voiceover": "./dist/voiceover.js"
  },
  "files": [
    "dist",
    "templates",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:smoke": "SMOKE=1 playwright test -c tests/playwright.config.ts",
    "test": "npm run build && npm run test:unit && npm run test:smoke",
    "voiceover": "node dist/voiceover.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  }
}
